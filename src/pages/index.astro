---
import Layout from '../layouts/Layout.astro';
import WelcomeSection from '../components/WelcomeSection/WelcomeSection';
import PopularRepairs from '../components/PopularRepairs/PopularRepairs.astro';
import WhyUsSection from '../components/WhyUsSection/WhyUsSection.astro';
import HowItWorksSection from '../components/HowItWorksSection/HowItWorksSection.astro';
import RepairPricingSection from '../components/RepairPricingSection/RepairPricingSection.astro';
