---
import Layout from '../../../../layouts/Layout.astro';
import Configurator from '../../../../components/Configurator/Configurator';
import ConfiguratorShell from '../../../../components/Configurator/ConfiguratorShell.astro';
import ContactSection from '../../../../components/ContactSection/ContactSection.astro';
import { getRepairIdFromSearch } from '../../../../components/Configurator/konfigurator-url';
import ModelRepairPrices from '../../../../components/Offer/ModelRepairPrices.astro';
import data from '../../../../data/data';

export function getStaticPaths() {
  const trimSlashes = (value: string) => value.replace(/^\/+|\/+$/g, '');

  const canonicalIpadPath = (phoneSlug: string): string | undefined => {
    const ipadBrand = data.find((item) => item.slug === 'apple-ipad/');
    const series = ipadBrand?.categories?.find((category) =>
      category.phones?.some((phone) => trimSlashes(phone.slug) === phoneSlug),
    );
    if (!series) return undefined;
    return `/offer/apple-ipad/${trimSlashes(series.slug)}/${phoneSlug}/`;
  };

  return data
    .filter(
      (item) =>
        item.categories &&
        (item.ignore !== 'list' || item.slug === 'apple-ipad/'),
    )
    .flatMap(({ slug, categories }) =>
      categories
        .filter((category) => (category.phones?.length ?? 0) > 0)
        .flatMap((category) =>
          category.phones.map((phone) => {
            const brand = trimSlashes(slug);
            const categorySlug = trimSlashes(category.slug);
            const phoneSlug = trimSlashes(phone.slug);
            const duplicateIpad = brand === 'apple' && categorySlug === 'ipad';
            return {
              params: {
                brand,
                category: categorySlug,
                phone: phoneSlug,
              },
              props: {
                modelName: phone.name,
                repairs: (phone.repairs ?? []).map((repair) => ({
                  name: repair.shortTitle || repair.title,
                  price: repair.price,
                  duration: repair.duration ?? '',
                })),
                noindex: duplicateIpad,
                canonicalPath: duplicateIpad ? canonicalIpadPath(phoneSlug) : undefined,
              },
            };
          }),
        ),
    );
}

const { brand, category, phone } = Astro.params;
const { modelName, repairs, noindex, canonicalPath } = Astro.props;
const initialRepairId = getRepairIdFromSearch(Astro.url.searchParams);
const initialModelSlugs = { brandSlug: brand!, categorySlug: category!, modelSlug: phone! };
---

<Layout
  metaTitle={`${modelName} – naprawa Warszawa | SpaceFix`}
  description={`Cennik naprawy ${modelName} w Warszawie (Ursus). Wymiana szybki, wyświetlacza i baterii. Gwarancja 6 miesięcy. SpaceFix, ul. Malinowa 16/U1.`}
  noindex={noindex}
  canonicalPath={canonicalPath}
>
  <ModelRepairPrices modelName={modelName} repairs={repairs} />
  <Configurator client:only="react" initialRepairId={initialRepairId} initialModelSlugs={initialModelSlugs}>
    <div
      slot="fallback"
      class="relative min-h-[calc(100vh-var(--header-height))] bg-[#fbfcfe]"
      aria-busy="true"
      aria-label="Ładowanie konfiguratora"
    />
  </Configurator>

  <ConfiguratorShell />
  <ContactSection />
</Layout>
