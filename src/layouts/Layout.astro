---
import Navigation from '../components/Navigation/Navigation';
import Footer from '../components/Footer/Footer';
import { businessName, contact, socialLinks } from '../config/site';
import { GOOGLE_RATING } from '../components/GoogleOpinions/types';

interface Props {
  /** Krótki tytuł dołączany do nazwy marki (np. „Konfigurator naprawy”). */
  title?: string;
  /** Pełny <title> nadpisujący domyślny szablon (używany na podstronach usług). */
  metaTitle?: string;
  /** Meta description dla danej podstrony. */
  description?: string;
  /** Panel i inne strony, których nie ma być w Google. */
  noindex?: boolean;
  /** Inny adres kanoniczny, gdy ta strona jest kopią (np. płaska lista iPadów). */
  canonicalPath?: string;
}

import '../index.css';

const { title, metaTitle, description: descriptionProp, noindex = false, canonicalPath } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

const defaultDescription =
  'Serwis telefonów w Warszawie, dzielnica Ursus. Wymiana szybki, baterii i wyświetlacza od ręki, gwarancja 6 miesięcy. ul. Malinowa 16/U1, tel. 730 889 759.';
const description = descriptionProp ?? defaultDescription;
const brandSuffix = 'SpaceFix – serwis telefonów Warszawa';
const transformedTitle =
  metaTitle ?? (title ? `${title} | ${brandSuffix}` : 'Serwis telefonów Warszawa Ursus – SpaceFix');
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);

const siteOrigin = Astro.site ? new URL(Astro.site).origin : 'https://spacefix.pl';
const ogImage = new URL(`${baseUrl}og-image.png`, siteOrigin).href;
const fontHref =
  'https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,900&display=swap';

const phoneSendTo = import.meta.env.PUBLIC_GADS_PHONE_SEND_TO || '';
const directionsSendTo = import.meta.env.PUBLIC_GADS_DIRECTIONS_SEND_TO || '';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ElectronicsStore',
  '@id': `${siteOrigin}/#business`,
  name: businessName,
  alternateName: ['SpaceFix', 'SpaceFix – serwis telefonów Warszawa Ursus'],
  image: ogImage,
  url: `${siteOrigin}/`,
  telephone: '+48730889759',
  email: contact.email,
  priceRange: '$$',
  hasMap: contact.mapsHref,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ul. Malinowa 16/U1',
    addressLocality: 'Warszawa',
    postalCode: '02-495',
    addressCountry: 'PL',
  },
  areaServed: [
    { '@type': 'City', name: 'Warszawa' },
    { '@type': 'AdministrativeArea', name: 'Ursus' },
  ],
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.1931235,
    longitude: 20.8805978,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '10:00',
      closes: '16:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: GOOGLE_RATING.score.toFixed(1),
    bestRating: GOOGLE_RATING.maxScore,
    reviewCount: GOOGLE_RATING.reviewCount,
  },
  sameAs: socialLinks.map((link) => link.href),
};
---

<!doctype html>
<html lang="pl" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{transformedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={transformedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="twitter:title" content={transformedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.png`} />
    <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontHref} />
    </noscript>
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NQH7J9X6');
    </script>
    <!-- End Google Tag Manager -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline
    ></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-16696753754"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'AW-16696753754');
    </script>
    <script define:vars={{ phoneSendTo, directionsSendTo }}>
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';

        const track = (name, sendTo) => {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: name });
          if (typeof window.gtag !== 'function') return;
          window.gtag('event', name);
          if (sendTo) window.gtag('event', 'conversion', { send_to: sendTo });
        };

        if (href.startsWith('tel:')) {
          track('phone_click', phoneSendTo);
          return;
        }

        if (href.includes('google.com/maps/dir')) {
          track('directions_click', directionsSendTo);
        }
      });
    </script>
  </head>
  <body>
    <Navigation client:idle />
    <main class="pt-[var(--header-height)] min-h-[calc(100vh-var(--header-height))]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
