---
import { contact } from '../../config/site';
import type { RepairType } from '../Configurator/configurator-data';

interface Props {
  repair: RepairType;
}

const { repair } = Astro.props;

const serviceName = repair.h1.replace(/\s+–\s+Warszawa$/, '');

const faqs = [
  {
    question: `Ile kosztuje ${serviceName.toLowerCase()}?`,
    answer: repair.repairKey
      ? `Cena zależy od modelu. Aktualny cennik jest w konfiguratorze SpaceFix. Serwis jest w Warszawie, dzielnica Ursus, przy ul. Malinowa 16/U1.`
      : `Ta naprawa nie ma jednej sztywnej ceny. Wycenę podajemy po krótkim opisie usterki, pod numerem ${contact.phoneDisplay}. Serwis jest w Warszawie, dzielnica Ursus.`,
  },
  {
    question: `Ile trwa ${serviceName.toLowerCase()}?`,
    answer:
      'Wiele napraw robimy od ręki, często tego samego dnia. Dokładny czas podajemy przy przyjęciu, po obejrzeniu urządzenia.',
  },
  {
    question: 'Jaka jest gwarancja?',
    answer: 'Na wykonaną naprawę dajemy 6 miesięcy gwarancji.',
  },
  {
    question: 'Gdzie oddać sprzęt w Warszawie?',
    answer: `SpaceFix, ${contact.address}. Od poniedziałku do piątku 10:00–19:00, w sobotę 10:00–16:00. W niedzielę nieczynne.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="section-padding bg-white" aria-labelledby="faq-heading">
  <div class="section-container">
    <h2 id="faq-heading" class="mb-8 text-center text-2xl font-bold text-[#010101] sm:mb-10 sm:text-3xl">
      Najczęstsze pytania
    </h2>
    <div class="mx-auto max-w-3xl divide-y divide-[#e2e8f0] rounded-2xl border border-[#e2e8f0] bg-white">
      {
        faqs.map((item) => (
          <details class="group px-5 py-4 sm:px-6">
            <summary class="cursor-pointer list-none text-base font-semibold text-[#010101] sm:text-lg [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {item.question}
                <span class="text-[#94a3b8] transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-[15px] leading-relaxed text-[#64748b] sm:text-base">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
